---
import Layout from '../layouts/Layout.astro';
import { Content } from '../md/adatkezeles.md';
const title = 'Adatkezelési tájékoztató — Four Seasons Klíma';
const description = 'A Four Seasons Klíma adatkezelési tájékoztatója: milyen személyes adatokat kezelünk a kapcsolatfelvételi űrlapon, milyen célból és jogalapon.';
---
<Layout title={title} description={description}>
  <main class="legal">
    <Content />
  </main>
</Layout>

<style>
  .legal{max-width:820px;margin:0 auto;padding:32px 22px 80px;color:#22323a;line-height:1.7;font-family:Inter,system-ui,sans-serif}
  .legal :global(h1){font-family:'Space Grotesk',system-ui,sans-serif;font-size:1.95rem;color:#0D5466;margin:8px 0 6px;letter-spacing:-.01em}
  .legal :global(h2){font-family:'Space Grotesk',system-ui,sans-serif;font-size:1.2rem;color:#0D5466;margin:32px 0 8px}
  .legal :global(a){color:#149a6e}
  .legal :global(table){border-collapse:collapse;width:100%;margin:14px 0;font-size:.94rem}
  .legal :global(th),.legal :global(td){border:1px solid #d8e3e7;padding:8px 12px;text-align:left;vertical-align:top}
  .legal :global(th){background:#eef5f7}
  .legal :global(blockquote){border-left:3px solid #23C3D4;margin:14px 0;padding:8px 16px;background:#f1f8fa;color:#33525c}
  .legal :global(code){background:#eef5f7;padding:1px 5px;border-radius:4px;font-size:.92em}
  .legal :global(hr){border:none;border-top:1px solid #e4ecef;margin:26px 0}
</style>
