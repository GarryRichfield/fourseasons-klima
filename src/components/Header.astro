---
import { business } from '../data/site.js';
---
<header>
  <div class="wrap nav">
    <a href="/" class="brand">
      <span class="mark"><svg viewBox="0 0 64 64" aria-hidden="true"><defs><clipPath id="hm"><circle cx="32" cy="32" r="27"/></clipPath></defs><g clip-path="url(#hm)"><rect width="32" height="64" fill="#F2784B"/><rect x="32" width="32" height="64" fill="#0D5466"/></g><line x1="32" y1="4" x2="32" y2="60" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><circle cx="20" cy="32" r="4.6" fill="#fff"/><g stroke="#fff" stroke-width="2.1" stroke-linecap="round"><line x1="20" y1="22.4" x2="20" y2="18.8"/><line x1="20" y1="45.2" x2="20" y2="41.6"/><line x1="10.8" y1="32" x2="14.4" y2="32"/><line x1="13.6" y1="25.6" x2="16.1" y2="28.1"/><line x1="13.6" y1="38.4" x2="16.1" y2="35.9"/></g><g stroke="#fff" stroke-width="2.1" stroke-linecap="round"><line x1="44" y1="21.5" x2="44" y2="42.5"/><line x1="34.9" y1="26.75" x2="53.1" y2="37.25"/><line x1="53.1" y1="26.75" x2="34.9" y2="37.25"/></g></svg></span>
      {business.name}
    </a>
    <nav class="navlinks">
      <a href="/#about">Bemutatkozás</a>
      <a href="/#units">Klímák</a>
      <a href="/#calc">Árkalkulátor</a>
      <a href="/#arak">Árak</a>
      <a href="/#contact">Kapcsolat</a>
    </nav>
    <a href={`tel:${business.phoneHref}`} class="phone">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.5-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2z"/></svg>
      {business.phone}
    </a>
    <button class="menutoggle" aria-label="Menü" id="menuToggle"><svg viewBox="0 0 24 24" width="20" fill="none" stroke="#0F1E2B" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
  </div>
</header>
<a id="top"></a>

<script>
  const t = document.getElementById('menuToggle');
  const h = document.querySelector('header');
  if (t && h) {
    t.addEventListener('click', () => h.classList.toggle('nav-open'));
    h.querySelectorAll('.navlinks a').forEach(a => a.addEventListener('click', () => h.classList.remove('nav-open')));
  }
</script>
